# Copia este archivo como .env y completa con los datos de tu proyecto Supabase.
# Base de datos usada: ExamenDesarrolloDeSistemas2
# NUNCA subas el archivo .env real a GitHub.

# Supabase -> Project Settings -> API Keys
SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Recomendado: Secret key (sb_secret_...). Equivale al service_role clásico.
SUPABASE_SECRET_KEY=TU_SECRET_KEY_AQUI

# Alternativa legada: service_role JWT (eyJ...). Usa UNA u otra.
# SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI

# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
